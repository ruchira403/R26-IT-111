{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",

    "moduleResolution": "node",

    "ignoreDeprecations": "6.0",
    "rootDir": "./src",
    "outDir": "./dist",

    "esModuleInterop": true,
    "resolveJsonModule": true,

    "strict": true,

    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true,

    "verbatimModuleSyntax": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "generated", "prisma.config.ts"]
}
