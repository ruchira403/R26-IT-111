generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique @db.VarChar(255)
  passwordHash  String         @map("password_hash") @db.Text
  role          String         @default("USER") @db.VarChar(50)
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  healthProfile HealthProfile?

  @@map("users")
}

model HealthProfile {
  id                         Int      @id @default(autoincrement())
  userId                     Int      @unique @map("user_id")
  age                        Int
  numberOfTeeth              Int      @map("number_of_teeth")
  numberOfMissingTeeth       Int      @map("number_of_missing_teeth")
  isPrimaryTeeth             Boolean  @default(false) @map("is_primary_teeth")
  smokingStatus              String   @map("smoking_status") @db.VarChar(20)
  alcoholUsage               String   @map("alcohol_usage") @db.VarChar(20)
  sugarUsage                 String   @map("sugar_usage") @db.VarChar(20)
  brushingFrequency          Int      @map("brushing_frequency")
  diabetesStatus             Boolean  @default(false) @map("diabetes_status")
  pregnancyStatus            Boolean  @default(false) @map("pregnancy_status")
  gumBleeding                Boolean  @default(false) @map("gum_bleeding")
  toothSensitivity           Boolean  @default(false) @map("tooth_sensitivity")
  calciumOrVitaminDeficiency Boolean  @default(false) @map("calcium_or_vitamin_deficiency")
  numberOfFilledTeeth        Int      @default(0) @map("number_of_filled_teeth")
  overallOralHygieneLevel    String   @map("overall_oral_hygiene_level") @db.VarChar(20)
  preferredLanguage          String   @default("en") @map("preferred_language") @db.VarChar(10)
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("health_profiles")
}
